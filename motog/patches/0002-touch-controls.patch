 }
 
+/* [motog patch 0002] pointer filter (the touch gamepad's claims) */
+static UiPointerFilter pointerFilter;
+void ui_set_pointer_filter(UiPointerFilter f) {
+	pointerFilter = f;
+}
+
 bool ui_next_pointer(Pointer* p) {
-	if (pqHead == pqTail) return false;
-	*p = pq[pqHead];
-	pqHead = (pqHead + 1) % PQ;
-	return true;
+	while (pqHead != pqTail) {
+		*p = pq[pqHead];
+		pqHead = (pqHead + 1) % PQ;
+		if (pointerFilter && pointerFilter(p)) continue; /* claimed: not the game's */
+		return true;
+	}
+	return false;
 }
 
 static bool mouseDown;
