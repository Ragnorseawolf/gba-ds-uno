+/* ------------------------------------------------------------- game file picker */
+
+/* The start-up picker (motog patch 0004): its own state, so it can never
+ * cross-talk with the folder picker's. Same shape as above. */
+static pthread_mutex_t filePickLock = PTHREAD_MUTEX_INITIALIZER;
+static char filePicked[1024];
+static int filePickState; /* 0 nothing, 1 a file picked, -1 cancelled */
+
+bool android_pick_file(void) {
+	JNIEnv* env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jobject activity = (jobject) SDL_AndroidGetActivity();
+	if (!env || !activity) return false;
+	/* by the activity's class: FindClass on this thread wouldn't see the app's classes */
+	jclass cls = (*env)->GetObjectClass(env, activity);
+	jmethodID m = (*env)->GetMethodID(env, cls, "pickRomFile", "()V");
+	bool ok = m != NULL;
+	if (ok) {
+		pthread_mutex_lock(&filePickLock);
+		filePickState = 0;
+		pthread_mutex_unlock(&filePickLock);
+		(*env)->CallVoidMethod(env, activity, m);
+	}
+	if ((*env)->ExceptionCheck(env)) {
+		(*env)->ExceptionClear(env);
+		ok = false;
+	}
+	(*env)->DeleteLocalRef(env, cls);
+	(*env)->DeleteLocalRef(env, activity);
+	return ok;
+}
+
+int android_take_picked_file(char* out, size_t size) {
+	pthread_mutex_lock(&filePickLock);
+	int st = filePickState;
+	if (st == 1) snprintf(out, size, "%s", filePicked);
+	filePickState = 0;
+	pthread_mutex_unlock(&filePickLock);
+	return st;
+}
+
+JNIEXPORT void JNICALL Java_io_github_kyannon_gbads_GbaDsActivity_nativeFilePicked(JNIEnv* env, jclass cls, jstring path) {
+	const char* p = path ? (*env)->GetStringUTFChars(env, path, NULL) : NULL;
+	pthread_mutex_lock(&filePickLock);
+	if (p && *p) {
+		snprintf(filePicked, sizeof(filePicked), "%s", p);
+		filePickState = 1;
+	} else {
+		filePickState = -1;
+	}
+	pthread_mutex_unlock(&filePickLock);
+	if (p) (*env)->ReleaseStringUTFChars(env, path, p);
+}
+
